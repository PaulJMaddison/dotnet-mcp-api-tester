# Placeholder-only example. Copy to .env only if your launcher loads dotenv files.
# .NET does not load .env files automatically.
#
# IMPORTANT: Azure credentials are process-start configuration for the local MCP
# server. They are never entered through an MCP tool or handed to Claude/Codex.

AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
AZURE_OPENAI_CHAT_DEPLOYMENT=YOUR-CHAT-DEPLOYMENT
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=YOUR-EMBEDDING-DEPLOYMENT

# RECOMMENDED LOCAL AUTHENTICATION
# 1. Run: az login
# 2. Give that identity permission to use the Azure OpenAI resource.
# 3. Use the Azure CLI identity from this local MCP process.
AZURE_OPENAI_AUTHENTICATION=DefaultAzureCredential
AZURE_OPENAI_CREDENTIAL_SOURCE=AzureCli

# Other supported identity source for Azure-hosted execution:
# AZURE_OPENAI_CREDENTIAL_SOURCE=ManagedIdentity
# General Azure credential chain:
# AZURE_OPENAI_CREDENTIAL_SOURCE=Default

# ALTERNATIVE: AZURE OPENAI API KEY
# Use only one authentication mode at a time. Keep the real value outside git.
# AZURE_OPENAI_AUTHENTICATION=ApiKey
# AZURE_OPENAI_API_KEY=SET-ONLY-IN-YOUR-LOCAL-ENVIRONMENT

# Bearer-token mode is also supported for controlled integrations:
# AZURE_OPENAI_AUTHENTICATION=BearerToken
# AZURE_OPENAI_AUTH_TOKEN=SET-ONLY-IN-YOUR-LOCAL-ENVIRONMENT

# Non-secret, process-start capability gate for explicitly supervised local API testing only.
# Leave unset/false for normal use.
# APITESTER_MCP_ALLOW_POLICY_MUTATION=true
