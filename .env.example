# Copy this file to .env only if your local launcher loads dotenv files.
# .NET configuration uses double underscores for nested settings.
# No Azure OpenAI key is needed: run `az login` locally.

AI__Provider=AzureOpenAI
AI__AzureOpenAI__Endpoint=https://aoai-apitester-demo-pjm.openai.azure.com/openai/v1/
AI__AzureOpenAI__ChatDeployment=gpt-41-mini-demo
AI__AzureOpenAI__ModelName=gpt-4.1-mini
AI__AzureOpenAI__Authentication=DefaultAzureCredential

# Keep actual application and database secrets in an ignored .env file,
# .NET user-secrets, or Azure Key Vault. Never fill them into this example.
Auth__ApiKeys__0=replace-locally
Persistence__ConnectionString=replace-locally
