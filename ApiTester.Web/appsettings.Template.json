{
  "Persistence": {
    "Provider": "SqlServer",
    "ConnectionString": "Server=<server>;Database=ApiTester;User Id=<user>;Password=<password>;TrustServerCertificate=True;"
  },
  "Auth": {
    "ApiKeys": [
      "replace-with-production-api-key"
    ]
  },
  "Entitlements": {
    "Tier": "Pro"
  },
  "AI": {
    "Provider": "AzureOpenAI",
    "AzureOpenAI": {
      "Endpoint": "https://<resource-name>.openai.azure.com/openai/v1/",
      "ChatDeployment": "<deployment-name>",
      "ModelName": "<model-name>",
      "Authentication": "DefaultAzureCredential"
    },
    "OpenAI": {
      "ApiKey": "",
      "BaseUrl": "https://api.openai.com/v1",
      "DefaultModel": "gpt-4o-mini",
      "ProModel": "gpt-4o"
    }
  }
}
